# Copie este arquivo para .env e preencha com a config do SDK web do Firebase
# (Console > Configurações do projeto > Seus apps > Configuração do SDK).
# Esses valores são públicos por design; a proteção está nas Firestore Security Rules.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
